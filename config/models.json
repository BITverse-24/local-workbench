{
  "$comment": "Primary text model with a capability-based visual extraction fallback.",
  "models": [
    {
      "id": "primary-model",
      "runtime": "ollama",
      "baseUrl": "http://127.0.0.1:1234/v1",
      "model": "qwen2.5-coder-7b-instruct-mlx",
      "capabilities": [
        "text",
        "structured-output",
        "code-generation"
      ],
      "requestTimeoutMs": 300000,
      "healthPath": "/models",
      "enabled": true,
      "maxOutputTokens": 1536,
      "toolCallingFormat": "json",
      "temperature": 0
    },
    {
      "id": "vision-fallback",
      "runtime": "ollama",
      "baseUrl": "http://127.0.0.1:1234/v1",
      "model": "qwen/qwen3-vl-4b",
      "capabilities": [
        "text",
        "image-input",
        "structured-output"
      ],
      "requestTimeoutMs": 60000,
      "healthPath": "/models",
      "enabled": true,
      "fallbackOnly": true,
      "maxOutputTokens": 1024,
      "temperature": 0
    }
  ]
}
