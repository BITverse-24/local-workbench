    "args": {
      "path": "broken-vendor-log-parser.py",
      "content": "\"\"\"Fixed vendor log parser for Flow B's repair demo.\"\"\"\n\nimport csv\nimport sys\n\n\ndef summarize(path: str) -> dict[str, int]:\n    counts = {\"ok\": 0, \"malformed\": 0, \"high\": 0}\n    with open(path, newline=\"\", encoding=\"utf-8\") as handle:\n        for row in csv.DictReader(handle):\n            # Fix Bug 1: Check if temperature exists before converting\n            temperature_c = row[\"temperature_c\"]\n            if temperature_c is None or temperature_c == \"\":\n                counts[\"malformed\"] += 1\n                continue\n            temperature = float(temperature_c)\n            # Fix Bug 2: Vendor spec says 350.0 is inclusive upper limit\n            if temperature >= 350.0:\n                counts[\"high\"] += 1\n            else:\n                counts[\"ok\"] += 1\n    return counts\n\n\nif __name__ == \"__main__\":\n    print(summarize(sys.argv[1]))\n"
    }
