{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["src/*"],
      "@ai/*": ["../ai/*"],
      "@config/*": ["../config/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "index.ts"]
}
