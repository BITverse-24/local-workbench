{
  "name": "workbench-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workbench backend — Electron main, SQLite persistence, gateway, tools (Phase DB first)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "dev": "npm --prefix ../electron_app run dev",
    "app:build": "npm --prefix ../electron_app exec vite build",
    "app:typecheck": "npm --prefix ../electron_app run typecheck"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "canvas": "^3.2.3",
    "chromadb": "^3.5.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.3.289",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "canvas@3.2.3": true,
    "esbuild@0.28.2": true
  }
}
