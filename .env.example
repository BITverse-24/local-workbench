# Development environment — copy to /.env (untracked, never committed).
# Only the variables below are read. Production/packaged builds use no .env file.
# Backend config resolution and model endpoints come from /config; this file
# supplies local-only values passed in once at Electron startup.




# Optional override for the model registry file. Defaults to <repo>/config/models.json.
WORKBENCH_MODELS_PATH=

# Optional override for the Vite dev-server URL Electron loads (debugging only).
WORKBENCH_FRONTEND_URL=
