// @see - https://www.electron.build/configuration/configuration
// Package only the production UI, Electron bundles, schema,
// and production dependencies. Local data, credentials, and project source
// are not part of the distributable.
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.local.workbench",
  "asar": true,
  "publish": null,
  "afterPack": "scripts/after-pack.cjs",
  "productName": "Local Workbench",
  "directories": {
    "output": "release/${version}"
  },
  "asarUnpack": [
    "**/*.node"
  ],
  "files": [
    "frontend/dist/**/*",
    "electron/dist-electron/**/*",
    "backend/src/main/persistence/schema.sql",
    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/__tests__/**",
    "!**/node_modules/**/fixtures/**",
    "!**/node_modules/**/benchmarks/**",
    "!**/node_modules/better-sqlite3/**/test_extension.*"
  ],
  "extraResources": [
    {
      "from": "backend/src/main/persistence/schema.sql",
      "to": "backend/schema.sql"
    }
  ],
  "mac": {
    "icon": "build/icons/icon.icns",
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "icon": "build/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "build/icons/icon.png",
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
