{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["../backend/src/*"],
      "@electron/*": ["./*"],
      "@config/*": ["../config/*"]
    }
  },
  "include": ["./**/*.ts"]
}
